{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Visitor Spend vs Length of Stay (2024)",
  "width": 500,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/ti-jago/FIT2179-Assignment2/refs/heads/main/data/tourism2024_clean.csv"
  },
  "transform": [
    {"filter": "datum.country !== 'Other Asia' && datum.country !== 'Other Europe' && datum.country !== 'Other Countries'"},
    {"calculate": "toNumber(datum.trips_2024)", "as": "trips_num"}
    
  ],
  "mark": {"type": "point", "filled": true, "opacity": 0.8},
  "encoding": {
    "x": {"field": "nights_2024", "type": "quantitative", "title": "Total Nights (thousands)"},
    "y": {"field": "spend_2024", "type": "quantitative", "title": "Total Spend ($M)"},
    "size": {"field": "trips_2024", "type": "quantitative", "title": "Trips (000s)", "scale": {"range": [50, 2000]}},
    "color": {"field": "country", "type": "nominal", "legend": {"title": "Country"}},
    "tooltip": [
      {"field": "country", "type": "nominal"},
      {"field": "trips_2024", "type": "quantitative", "title": "Trips (000s)", "format": ","},
      {"field": "nights_2024", "type": "quantitative", "title": "Nights (000s)", "format": ","},
      {"field": "spend_2024", "type": "quantitative", "title": "Spend ($M)", "format": ","}
    ]
  }
}
