{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging horizontal bar chart showing projected percentage change in visitor trips to Australia by country from 2024 to 2025. Teal = growth, rust/orange = decline. Zero rule line separates positive and negative values. Data source: Tourism Research Australia, IVS 2024.",
  "width": "container",
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/ti-jago/FIT2179-Assignment2/refs/heads/main/data/tourism2024_clean.csv"
  },
  "transform": [
    {
      "filter": "datum.country !== 'Other Asia' && datum.country !== 'Other Europe' && datum.country !== 'Other Countries'"
    },
    { "calculate": "toNumber(datum.trips_change_pct)", "as": "change" },
    {
      "window": [{ "op": "rank", "as": "rank" }],
      "sort": [{ "field": "change", "order": "descending" }]
    }
  ],
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": { "field": "rank", "order": "ascending" },
          "title": null,
          "axis": { "labelFont": "DM Sans", "labelFontSize": 11 }
        },
        "x": {
          "field": "change",
          "type": "quantitative",
          "title": "% Change in Visitor Trips (2024 to 2025)",
          "axis": { "labelFont": "DM Sans", "titleFont": "DM Sans", "titleFontSize": 10 }
        },
        "color": {
          "condition": { "test": "datum.change >= 0", "value": "#0d6e78" },
          "value": "#c0522a"
        },
        "tooltip": [
          { "field": "country", "type": "nominal", "title": "Country" },
          { "field": "change", "type": "quantitative", "title": "Growth (%)", "format": "+.0f" }
        ]
      }
    },
    {
      "mark": { "type": "rule", "color": "#0f0e0c", "strokeWidth": 1 },
      "encoding": { "x": { "datum": 0 } }
    }
  ]
}
