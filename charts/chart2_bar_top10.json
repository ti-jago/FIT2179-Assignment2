{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal bar chart of the top 10 source countries by visitor trip volume to Australia (2024). Bars are sorted descending with inline value labels. Data source: Tourism Research Australia, IVS 2024.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/ti-jago/FIT2179-Assignment2/refs/heads/main/data/tourism2024_clean.csv"
  },
  "transform": [
    {
      "filter": "datum.country !== 'Other Asia' && datum.country !== 'Other Europe' && datum.country !== 'Other Countries' && datum.country !== 'Scandinavia'"
    },
    { "calculate": "toNumber(datum.trips_2024)", "as": "trips_num" },
    {
      "window": [{ "op": "rank", "as": "rank" }],
      "sort": [{ "field": "trips_num", "order": "descending" }]
    },
    { "filter": "datum.rank <= 10" }
  ],
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": { "field": "rank", "order": "ascending" },
          "title": null,
          "axis": { "labelFont": "DM Sans", "labelFontSize": 11 }
        },
        "x": {
          "field": "trips_num",
          "type": "quantitative",
          "title": "Visitor Trips (thousands)",
          "axis": { "labelFont": "DM Sans", "titleFont": "DM Sans", "titleFontSize": 10 }
        },
        "color": {
          "field": "trips_num",
          "type": "quantitative",
          "scale": { "scheme": "tealblues" },
          "legend": null
        },
        "tooltip": [
          { "field": "country", "type": "nominal", "title": "Country" },
          { "field": "trips_num", "type": "quantitative", "title": "Trips (000s)", "format": "," }
        ]
      }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 4, "fontSize": 10, "color": "#7a746c" },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": { "field": "rank", "order": "ascending" }
        },
        "x": { "field": "trips_num", "type": "quantitative" },
        "text": { "field": "trips_num", "type": "quantitative", "format": "," }
      }
    }
  ]
}
