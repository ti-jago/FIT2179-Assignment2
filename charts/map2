{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Top 10 International Visitor Trips to Australia by Country (2024)",
  "width": 500,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/ti-jago/FIT2179-Assignment2/refs/heads/main/data/tourism2024_clean.csv"
  },
  "transform": [
    {"filter": "datum.country !== 'Other Asia' && datum.country !== 'Other Europe' && datum.country !== 'Other Countries' && datum.country !== 'Scandinavia'"},
    {"calculate": "toNumber(datum.trips_2024)", "as": "trips_num"},
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "trips_num", "order": "descending"}]},
    {"filter": "datum.rank <= 10"}
  ],
  "mark": "bar",
  "encoding": {
    "y": {"field": "country", "type": "nominal", "sort": {"field": "rank", "order": "ascending"}, "title": "Country"},
    "x": {"field": "trips_num", "type": "quantitative", "title": "Visitor Trips (thousands)"},
    "color": {"field": "trips_num", "type": "quantitative", "scale": {"scheme": "tealblues"}, "legend": null},
    "tooltip": [
      {"field": "country", "type": "nominal", "title": "Country"},
      {"field": "trips_num", "type": "quantitative", "title": "Trips (000s)", "format": ","}
    ]
  }
}
