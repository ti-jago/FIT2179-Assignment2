{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap showing the share of visitor arrivals to Australia by intended duration of stay, across years 2019 to 2025. Each cell is normalised to year total so colour reflects share, not raw volume. Darker = more visitors chose that duration. Data source: ABS 3401.0 Table 6.",
  "width": "container",
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/ti-jago/FIT2179-Assignment2/refs/heads/main/data/duration_of_stay_annual.csv"
  },
  "transform": [
    { "filter": "datum.year >= 2019 && datum.year <= 2025" },
    { "calculate": "toNumber(datum.arrivals)", "as": "arrivals_num" },
    { "calculate": "toString(datum.year)", "as": "year_str" },
    {
      "joinaggregate": [{ "op": "sum", "field": "arrivals_num", "as": "year_total" }],
      "groupby": ["year_str"]
    },
    { "calculate": "datum.arrivals_num / datum.year_total", "as": "share" },
    {
      "calculate": "datum.duration === 'Under 1 week' ? 0 : datum.duration === '1 and under 2 weeks' ? 1 : datum.duration === '2 weeks and under 1 month' ? 2 : datum.duration === '1 and under 2 months' ? 3 : datum.duration === '2 and under 3 months' ? 4 : datum.duration === '3 and under 6 months' ? 5 : 6",
      "as": "dur_order"
    }
  ],
  "mark": { "type": "rect" },
  "encoding": {
    "x": {
      "field": "year_str",
      "type": "ordinal",
      "title": "Year",
      "axis": { "labelFont": "DM Sans", "titleFont": "DM Sans", "titleFontSize": 10 }
    },
    "y": {
      "field": "duration",
      "type": "ordinal",
      "sort": { "field": "dur_order", "order": "ascending" },
      "title": "Intended Duration",
      "axis": {
        "labelFont": "DM Sans",
        "titleFont": "DM Sans",
        "titleFontSize": 10,
        "labelLimit": 200
      }
    },
    "color": {
      "field": "share",
      "type": "quantitative",
      "scale": { "scheme": "tealblues", "domain": [0, 0.35] },
      "legend": {
        "title": "Share",
        "format": ".0%",
        "labelFont": "DM Sans",
        "titleFont": "DM Sans",
        "titleFontSize": 10,
        "gradientLength": 120
      }
    },
    "tooltip": [
      { "field": "duration", "type": "nominal", "title": "Duration" },
      { "field": "year_str", "type": "nominal", "title": "Year" },
      { "field": "share", "type": "quantitative", "title": "Share", "format": ".1%" },
      { "field": "arrivals_num", "type": "quantitative", "title": "Arrivals", "format": "," }
    ]
  }
}
