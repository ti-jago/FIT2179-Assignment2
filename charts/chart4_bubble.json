{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bubble chart showing total visitor nights stayed (x, log scale) vs total spend in $M AUD (y) vs trip volume (bubble size) by country. Log scale applied to x-axis to reduce clustering. Country labels annotated for high-spend nations. Data source: Tourism Research Australia, IVS 2024.",
  "width": "container",
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/ti-jago/FIT2179-Assignment2/refs/heads/main/data/tourism2024_clean.csv"
  },
  "transform": [
    {
      "filter": "datum.country !== 'Other Asia' && datum.country !== 'Other Europe' && datum.country !== 'Other Countries'"
    },
    { "calculate": "toNumber(datum.nights_2024)", "as": "nights_num" },
    { "calculate": "toNumber(datum.spend_2024)", "as": "spend_num" },
    { "calculate": "toNumber(datum.trips_2024)", "as": "trips_num" }
  ],
  "layer": [
    {
      "mark": { "type": "point", "filled": true, "opacity": 0.75 },
      "encoding": {
        "x": {
          "field": "nights_num",
          "type": "quantitative",
          "title": "Total Nights Stayed (000s, log scale)",
          "scale": { "type": "log" },
          "axis": { "labelFont": "DM Sans", "titleFont": "DM Sans", "titleFontSize": 10 }
        },
        "y": {
          "field": "spend_num",
          "type": "quantitative",
          "title": "Total Spend ($M AUD)",
          "axis": { "labelFont": "DM Sans", "titleFont": "DM Sans", "titleFontSize": 10 }
        },
        "size": {
          "field": "trips_num",
          "type": "quantitative",
          "scale": { "range": [40, 2200] },
          "legend": null
        },
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": { "scheme": "tableau10" },
          "legend": null
        },
        "tooltip": [
          { "field": "country", "type": "nominal", "title": "Country" },
          { "field": "trips_num", "type": "quantitative", "title": "Trips (000s)", "format": "," },
          { "field": "nights_num", "type": "quantitative", "title": "Nights (000s)", "format": "," },
          { "field": "spend_num", "type": "quantitative", "title": "Spend ($M)", "format": "," }
        ]
      }
    },
    {
      "mark": { "type": "text", "fontSize": 9, "dy": -10, "color": "#7a746c" },
      "transform": [{ "filter": "datum.spend_num > 1000" }],
      "encoding": {
        "x": {
          "field": "nights_num",
          "type": "quantitative",
          "scale": { "type": "log" }
        },
        "y": { "field": "spend_num", "type": "quantitative" },
        "text": { "field": "country", "type": "nominal" }
      }
    }
  ]
}
